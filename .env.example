# ── Identidade desta IP ────────────────────────────────────────────────────────
THIS_ISPB=00000000
THIS_NAME=Minha Instituicao de Pagamento

# Credenciais que esta IP usa para se autenticar com os peers
API_KEY_ID=key_minha_ip
API_SECRET=gere_um_secret_forte_aqui_32chars_minimo

# ── Peers autorizados ──────────────────────────────────────────────────────────
# JSON: {"key_id_da_outra_ip": "secret_da_outra_ip"}
KNOWN_PEERS_JSON={"key_ip_b": "secret_da_ip_b_aqui"}

# ── Webhook da outra IP ────────────────────────────────────────────────────────
PEER_WEBHOOK_URL=https://ip-b.exemplo.com.br/webhooks

# ── Banco de dados ─────────────────────────────────────────────────────────────
# Dev:  sqlite+aiosqlite:///./bilateral.db
# Prod: postgresql+asyncpg://user:pass@host:5432/bilateral
DATABASE_URL=sqlite+aiosqlite:///./bilateral.db

# ── Admin ─────────────────────────────────────────────────────────────────────
# Chave para rotas /admin/* e /onboarding/*
ADMIN_KEY=gere_uma_chave_forte_aqui

# ── Listas externas de sancionados ─────────────────────────────────────────────
# Coloque arquivos CSV em lists/ofac.csv e lists/coaf.csv
# Colunas esperadas: document (CPF/CNPJ sem pontuação)
# Exemplo: lists/ofac.csv, lists/coaf.csv

# ── Servidor ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false
